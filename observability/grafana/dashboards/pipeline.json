      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(worker_inference_duration_seconds_bucket{instance=~\"$worker\"}[1m])))",
          "legendFormat": "p50",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(worker_inference_duration_seconds_bucket{instance=~\"$worker\"}[1m])))",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(worker_inference_duration_seconds_bucket{instance=~\"$worker\"}[1m])))",
          "legendFormat": "p99",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
