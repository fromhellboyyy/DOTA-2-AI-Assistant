        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Длительность inference: p50, p95, p99",
      "description": "Бакеты считаются от INFERENCE_DELAY_SEC (см. app/metrics.py).",
