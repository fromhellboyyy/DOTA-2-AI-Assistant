      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "sum by (instance) (worker_tasks_in_flight{instance=~\"$worker\"})",
          "legendFormat": "{{instance}}",
          "editorMode": "code",
          "range": true
